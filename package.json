  "exports": {
    ".": { "types": "./dist/perky.d.ts", "import": "./dist/perky.js" }
  },
  "files": ["dist/perky.js", "dist/perky.d.ts", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
